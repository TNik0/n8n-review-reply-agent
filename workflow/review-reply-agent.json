        "subject": "=Review needs approval: {{ $json.review_id }} ({{ $json.category }})",
        "message": "=<div style=\"font-family: Arial, sans-serif; font-size: 14px; color: #222; max-width: 600px;\">\n\n  <p style=\"font-size: 16px; margin: 0 0 16px 0;\">\n    <strong>⚠️ A Google review needs your approval before any reply is posted.</strong>\n  </p>\n\n  <table style=\"border-collapse: collapse; width: 100%; margin-bottom: 16px;\">\n    <tr>\n      <td style=\"padding: 8px; background: #f4f4f4; width: 130px;\"><strong>Review ID</strong></td>\n      <td style=\"padding: 8px; border-bottom: 1px solid #eee;\">{{ $json.review_id }}</td>\n    </tr>\n    <tr>\n      <td style=\"padding: 8px; background: #f4f4f4;\"><strong>Category</strong></td>\n      <td style=\"padding: 8px; border-bottom: 1px solid #eee;\">{{ $json.category }}</td>\n    </tr>\n    <tr>\n      <td style=\"padding: 8px; background: #f4f4f4;\"><strong>Why flagged</strong></td>\n      <td style=\"padding: 8px; border-bottom: 1px solid #eee;\">{{ $json.reason }}</td>\n    </tr>\n  </table>\n\n  <p style=\"margin: 0 0 6px 0;\"><strong>Suggested draft (NOT posted):</strong></p>\n  <div style=\"padding: 12px; background: #fff8e1; border-left: 4px solid #f5a623; margin-bottom: 16px;\">\n    {{ $json.draft_reply || '<em>No draft. This review was flagged as spam or needs a manual response.</em>' }}\n  </div>\n\n  <p style=\"margin: 0 0 16px 0;\">\n    Approve, edit or reject it in the review sheet.\n  </p>\n\n  <p style=\"font-size: 12px; color: #888; margin: 0;\">\n    Sent automatically by the Review Reply Agent. Nothing is posted without human approval.\n  </p>\n\n</div>",
